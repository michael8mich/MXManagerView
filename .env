# Base URL for opening records in mFlow from the Manager View
# Example: http://mx/mFlow
VITE_MFLOW_BASE_URL=http://mx/mFlow

# Enable fetching from MX API (POST /mxssddql/Query)
# Values:
# - off: use local public/data.json
# - problems: keep groups from local, fetch problems from MX per group
# - all: server-only (no public/data.json at runtime)
# Note: In dev, Vite proxies /mxssddql/* to http://mx (see vite.config.ts)
VITE_MX_USE_REMOTE_API=all
VITE_MX_QUERY_URL=http://mx/mxssddql/Query
VITE_MX_PAGE_SIZE=1000

# Optional dev helper: break into debugger right after MX Query JSON is received.
# Requires DevTools/VS Code debugger attached.
# VITE_MX_DEBUG_ON_FETCH=true
